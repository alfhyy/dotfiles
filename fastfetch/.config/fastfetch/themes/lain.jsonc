{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "90",
      "title": "37"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": ">> USER...",
      "format": "{user-name}@navi"
    },
    {
      "type": "os",
      "key": ">> OS....."
    },
    {
      "type": "kernel",
      "key": ">> KERNEL."
    },
    {
      "type": "packages",
      "key": ">> PKGS...",
      "format": "{pacman}"
    },
    {
      "type": "shell",
      "key": ">> SHELL.."
    },
    {
      "type": "wm",
      "key": ">> WM....."
    },
    {
      "type": "uptime",
      "key": ">> UPTIME."
    },
    {
      "type": "media",
      "key": ">> SIG...."
    },
    "break"
  ]
}
