* {
    font: "Departure Mono 11";
    background-color: transparent;
    text-color: var(on-surface);
}

window {
    transparency: "real";
    background-color: var(surface);
    border-radius: 0px;
    border: 1px;
    border-color: var(outline);
    width: 520px;
    location: center;
    anchor: center;
}

mainbox {
    spacing: 0px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    padding: 14px 16px 10px 16px;
    children: [ "prompt", "entry" ];
    spacing: 8px;
}

prompt {
    text-color: var(on-surface-variant);
}

entry {
    placeholder: "";
    placeholder-color: var(on-surface-variant);
    cursor: text;
}

listview {
    columns: 1;
    lines: 8;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    fixed-height: true;
    spacing: 0px;
    padding: 6px 8px 10px 8px;
    border: 1px 0px 0px 0px;
    border-color: var(outline-variant);
}

element {
    spacing: 10px;
    padding: 4px 8px;
    border-radius: 0px;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: var(on-surface);
}

element selected.normal {
    background-color: var(on-surface);
    text-color: var(surface);
}

element-icon {
    size: 16px;
    cursor: inherit;
}

element-text {
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
}
