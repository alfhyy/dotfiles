configuration {
    modi: "drun,run";
    icon-theme: "Papirus";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{name}";
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "";
    display-run: "";
    sidebar-mode: false;
}

@import "colors.rasi"
@import "themes/current.rasi"
